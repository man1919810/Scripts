        print("立即翻译了", translatedCount, "个文本元素")
        print("耗时:", string.format("%.2f", elapsedTime), "秒")
        print("＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝")
    else
        showNotification("翻译引擎加载失败")
